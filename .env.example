# ─────────────────────────────────────────────────────────────────────────────
# Talabk — environment variable template
#
# Copy this file to `.env.local` for local dev, or paste these keys into the
# Vercel project's environment-variables UI for production.
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle.
# Everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only — never expose to the browser. Rotate quarterly.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# For backup-db.sh — direct Postgres connection (use pooler URL :6543 in prod).
SUPABASE_DB_URL=postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres

# ── Domain / multi-tenant routing ───────────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN=talabk.app
NEXT_PUBLIC_SITE_URL=https://talabk.app

# ── Sentry ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only — for source-map upload. CI secret.
SENTRY_AUTH_TOKEN=

# ── Cron protection ─────────────────────────────────────────────────────────
# Long random string. Used as `Authorization: Bearer $CRON_SECRET` by Vercel.
CRON_SECRET=

# ── Billing ─────────────────────────────────────────────────────────────────
# USDT TRC-20 wallet. Empty → USDT payment method hidden in /billing.
NEXT_PUBLIC_USDT_WALLET=

# ── Brand / contact (used by lib/brand.ts) ──────────────────────────────────
# Public WhatsApp number — international format, digits only (no +).
NEXT_PUBLIC_PUBLIC_WHATSAPP=
# Display form for landing copy (e.g. "wa.me/218912345678").
NEXT_PUBLIC_PUBLIC_WHATSAPP_DISPLAY=
# Demo URL shown to prospects who want a sneak peek before trial.
NEXT_PUBLIC_DEMO_URL=
# Founder trust pack (landing P0 from PM audit).
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_PHOTO=
