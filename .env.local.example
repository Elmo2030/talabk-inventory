# ============================================
# Supabase Configuration
# ============================================
# احصل على هذه القيم من Supabase Dashboard:
# 1. اذهب إلى Project Settings → API
# 2. انسخ Project URL إلى السطر الأول
# 3. انسخ anon/public key إلى السطر الثاني
# 4. (اختياري) انسخ service_role key إلى السطر الثالث - للعمليات الإدارية فقط
# ============================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Server-side only (لا تشارك هذا أبداً)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ============================================
# Sentry — مراقبة الأخطاء
# ============================================
# احصل على DSN من: sentry.io → Settings → Projects → Client Keys
# ============================================
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=inventory-app
# Auth token لرفع source maps (للـ CI فقط — لا تضعه في .env.local)
SENTRY_AUTH_TOKEN=sntrys_...

# ============================================
# Moyasar — بوابة الدفع
# ============================================
# احصل على المفاتيح من: moyasar.com → Dashboard → API Keys
# ============================================
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_...
MOYASAR_SECRET_KEY=sk_test_...
# يجب أن يتطابق مع قيمة WEBHOOK_SECRET في Moyasar Dashboard
MOYASAR_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# Domain Configuration
# ============================================
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
